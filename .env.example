DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Wajib — login & JWT
JWT_SECRET=isi-random-panjang-openssl-rand-hex-32
ADMIN_PASSWORD=password-login-kamu-sendiri

# Wajib — Gemini AI untuk generate caption/artikel
GEMINI_API_KEY=isi-dari-aistudio.google.com

# Wajib — akses lintas-app (ZPos cron artikel baca /api/apps)
CROSS_APP_SECRET=isi-cross-app-secret-random-32-plus

# WA Massal — Fonnte API
FONNTE_TOKEN=isi-dari-fonnte.com

# Video storage — path volume (wajib di produksi)
VIDEO_STORAGE_DIR=/data/videos

# HTTP deploy fix — set true jika deploy via HTTP (bukan HTTPS)
# Cookie Secure=false agar browser terima cookie di HTTP
ELECTRON_APP=true

# Cron artikel — push ke GitHub (opsional, hanya untuk artikel:harian)
GITHUB_TOKEN=ghp_personal_access_token_repo_scope

# Opsional — scrape nomor dari Google Maps
# GOOGLE_PLACES_API_KEY=isi-dari-google-cloud-console

# Opsional — path storage media WA (default: /data/wa-media)
# WA_MEDIA_DIR=/data/wa-media
